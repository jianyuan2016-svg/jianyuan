  document.getElementById('confirm-ok-btn').className='btn flex-1'+(opts.okClass?` ${opts.okClass}`:'  btn-red');
  document.getElementById('confirm-overlay').style.display='flex';
}
function confirmOk(){
  document.getElementById('confirm-overlay').style.display='none';
  if(_confirmCallback&&typeof window[_confirmCallback]==='function')window[_confirmCallback]();
  _confirmCallback=null;
}
function confirmCancel(){
  document.getElementById('confirm-overlay').style.display='none';
  _confirmCallback=null;
}

// ════════════════════════════════════════
// GOOGLE SHEETS API
// ════════════════════════════════════════
async function apiCall(action,data={}){
  // ★ 修復1：GET讀取用 query string，POST寫入用 body，分開路由
  const isRead=(action==='getOrders'||action==='getFinance'||action==='ping');
  const url=isRead?`${API_URL}?action=${action}`:API_URL;
  const options={
    method:isRead?'GET':'POST',
    redirect:'follow', // ★ 修復2：追蹤 GAS 302 重定向，不中斷請求
  };
  if(!isRead){
    // ★ 修復3：用 text/plain;charset=utf-8 繞過 CORS Preflight 檢查
    options.headers={'Content-Type':'text/plain;charset=utf-8'};
    options.body=JSON.stringify({action,...data});
  }
  const res=await fetch(url,options);
  if(!res.ok)throw new Error(`HTTP ${res.status}`);
  const json=await res.json();
  if(json.error)throw new Error(json.error);
  return json;
}

// ★ 從 Google Sheets 讀取訂單
// GAS 回傳：{"data":[{"日期":"...","訂單號碼":233,"姓名":"...",...}]}
// 映射為本系統 saveOrder 使用的欄位名稱（id/orderNum/orderDate/name/phone/model/battery/price/cost/status/note）
async function fetchOrdersFromSheets(){
  showSync('loading','從雲端讀取…');
  try{
    const res=await apiCall('getOrders');
    const rows=res.data||[];

    // ★ 防洗掉：API 回空陣列時保留本地資料，不覆蓋
    if(!rows||rows.length===0){
      showSync('err','雲端無資料，保留本地快取');
      return load(KEYS.orders);
    }

    // ★ 中文鍵名 → 系統內部英文欄位映射
    const mapped=rows.map(r=>{
      const orderNum=String(r['訂單號碼']||r['orderId']||'');
      return{
        id:orderNum||('o_'+Date.now()+'_'+Math.random().toString(36).slice(2)),
        orderNum,
        orderDate:r['日期']||r['date']||'',
        name:r['姓名']||r['name']||'',
        phone:r['電話']||r['phone']||'',
        model:r['車型']||r['model']||'',
        battery:r['電池']||r['battery']||'',
        price:parseFloat(r['金額']||r['amount']||0)||0,
        cost:parseFloat(r['成本']||r['cost']||0)||0,
        status:r['狀態']||r['status']||'待交車',
        note:r['備註']||r['note']||'',
        createdAt:Date.now(),
      };
    });

    save(KEYS.orders,mapped);
    showSync('ok',`已同步 ${mapped.length} 筆訂單`);
    return mapped;
  }catch(e){
    // ★ 連線失敗時絕不覆蓋本地資料，指示燈轉紅
    showSync('err','同步失敗: '+e.message);
    throw e;
  }
}

// ★ 寫入單筆訂單到 Google Sheets
