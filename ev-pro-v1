<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="EV PRO 管理">
<meta name="theme-color" content="#2563eb">
<title>EV PRO 管理</title>
<link rel="apple-touch-icon" href="https://cdn-icons-png.flaticon.com/512/3103/3103443.png">
<link rel="icon" type="image/png" href="https://cdn-icons-png.flaticon.com/512/3103/3103443.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Noto+Sans+TC:wght@400;500;700;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>tailwind.config={darkMode:'class',theme:{extend:{fontFamily:{sans:['Nunito','Noto Sans TC','sans-serif'],mono:['JetBrains Mono','monospace']}}}}</script>
<style>
:root{
  --bg:#f1f5f9;
  --surface:rgba(255,255,255,0.75);
  --surface-solid:#ffffff;
  --surface2:rgba(241,245,249,0.8);
  --border:rgba(203,213,225,0.7);
  --border-solid:#e2e8f0;
  --blue:#2563eb;--blue-l:#dbeafe;--blue-d:#1d4ed8;
  --green:#16a34a;--green-l:#dcfce7;
  --amber:#d97706;--amber-l:#fef3c7;
  --red:#dc2626;--red-l:#fee2e2;
  --purple:#7c3aed;--purple-l:#ede9fe;
  --text:#0f172a;--text2:#475569;--text3:#94a3b8;
  --sh:0 4px 24px rgba(37,99,235,.08),0 1px 4px rgba(0,0,0,.04);
  --sh-lg:0 12px 40px rgba(37,99,235,.14);
  --glass:blur(20px) saturate(180%);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{
  background:linear-gradient(135deg,#dbeafe 0%,#f0fdf4 40%,#fef3c7 100%);
  background-attachment:fixed;
  color:var(--text);font-family:'Nunito','Noto Sans TC',sans-serif;
  min-height:100vh;overscroll-behavior:none;
}
body{padding-bottom:88px}
.page{display:none;animation:pgIn .25s cubic-bezier(.4,0,.2,1)}
.page.active{display:block}
@keyframes pgIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

/* Glassmorphism card */
.card{
  background:var(--surface);
  backdrop-filter:var(--glass);-webkit-backdrop-filter:var(--glass);
  border:1px solid var(--border);
  border-radius:20px;padding:16px;margin-bottom:12px;
  box-shadow:var(--sh);transition:box-shadow .2s,transform .1s;
}
.card:active{box-shadow:var(--sh-lg);transform:scale(.995)}
.card-flat{
  background:rgba(255,255,255,0.55);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  border:1px solid var(--border);border-radius:14px;
  padding:13px 14px;margin-bottom:8px;
}
.glass-header{
  background:rgba(255,255,255,0.72);
  backdrop-filter:var(--glass);-webkit-backdrop-filter:var(--glass);
  border-bottom:1px solid var(--border);
  padding:16px 20px 14px;
  position:sticky;top:0;z-index:50;
}

/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;padding:11px 18px;border-radius:13px;font-weight:800;font-size:14px;cursor:pointer;border:none;transition:all .15s;gap:6px;white-space:nowrap;font-family:inherit}
.btn:active{transform:scale(.95)}
.btn-blue{background:var(--blue);color:#fff;box-shadow:0 4px 16px rgba(37,99,235,.35)}
.btn-blue:hover{background:var(--blue-d)}
.btn-green{background:var(--green);color:#fff;box-shadow:0 4px 16px rgba(22,163,74,.3)}
.btn-red{background:var(--red);color:#fff;box-shadow:0 4px 12px rgba(220,38,38,.25)}
.btn-ghost{background:rgba(255,255,255,0.7);backdrop-filter:blur(8px);color:var(--text2);border:1.5px solid var(--border)}
.btn-ghost:hover{border-color:var(--blue);color:var(--blue)}
.btn-amber{background:var(--amber);color:#fff}
.btn-sm{padding:7px 14px;font-size:12px;border-radius:10px}
.btn-xs{padding:5px 10px;font-size:11px;border-radius:8px;font-weight:800}

/* Inputs */
.input{
  background:rgba(255,255,255,0.75);backdrop-filter:blur(8px);
  border:1.5px solid var(--border);color:var(--text);
  border-radius:12px;padding:10px 14px;font-size:15px;
  width:100%;font-family:inherit;transition:all .15s;-webkit-appearance:none;
}
.input:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.12);background:rgba(255,255,255,.95)}
.input::placeholder{color:var(--text3)}
select.input{cursor:pointer}
textarea.input{resize:vertical;min-height:72px}
label.lbl{display:block;font-size:12px;font-weight:800;color:var(--text2);margin-bottom:5px;letter-spacing:.4px}

/* Bottom Nav — glass */
.nav-bar{
  position:fixed;bottom:0;left:0;right:0;
  background:rgba(255,255,255,0.88);backdrop-filter:var(--glass);-webkit-backdrop-filter:var(--glass);
  border-top:1px solid var(--border);display:flex;z-index:100;
  padding-bottom:env(safe-area-inset-bottom);
  box-shadow:0 -4px 24px rgba(37,99,235,.07);
}
.nav-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:9px 4px 10px;cursor:pointer;transition:color .15s;color:var(--text3);font-size:10px;gap:3px;font-weight:700;letter-spacing:.2px;user-select:none}
.nav-item.active{color:var(--blue)}
.nav-item svg{width:22px;height:22px;stroke-width:2;transition:stroke .15s}
.nav-item.active svg{stroke:var(--blue)}
.nav-dot{width:4px;height:4px;border-radius:50%;background:var(--blue);margin-top:1px;opacity:0;transition:opacity .2s}
.nav-item.active .nav-dot{opacity:1}

/* Modal */
.modal-overlay{position:fixed;inset:0;background:rgba(15,23,42,.5);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);display:flex;align-items:flex-end;z-index:200;animation:ovIn .2s ease}
@keyframes ovIn{from{opacity:0}to{opacity:1}}
.modal{background:rgba(255,255,255,.96);backdrop-filter:var(--glass);border-radius:24px 24px 0 0;border:1px solid var(--border);border-bottom:none;padding:20px;width:100%;max-height:92vh;overflow-y:auto;animation:slUp .28s cubic-bezier(.4,0,.2,1);box-shadow:0 -8px 40px rgba(37,99,235,.12)}
@keyframes slUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.modal-handle{width:36px;height:4px;background:var(--border-solid);border-radius:2px;margin:0 auto 16px}

/* Custom confirm dialog */
.confirm-overlay{position:fixed;inset:0;background:rgba(15,23,42,.55);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;z-index:300;padding:20px;animation:ovIn .15s ease}
.confirm-box{background:rgba(255,255,255,.97);border-radius:20px;padding:24px 20px 20px;max-width:340px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,.2);animation:popIn .2s cubic-bezier(.34,1.56,.64,1)}
@keyframes popIn{from{opacity:0;transform:scale(.88)}to{opacity:1;transform:scale(1)}}

/* Toast */
#toast{position:fixed;top:24px;left:50%;transform:translateX(-50%) translateY(-70px);background:rgba(255,255,255,.95);backdrop-filter:var(--glass);border:1.5px solid var(--green);color:var(--green);padding:10px 20px;border-radius:30px;font-size:14px;font-weight:800;z-index:999;transition:transform .35s cubic-bezier(.34,1.56,.64,1);white-space:nowrap;box-shadow:0 4px 20px rgba(22,163,74,.2);pointer-events:none}
#toast.show{transform:translateX(-50%) translateY(0)}
#toast.err{border-color:var(--red);color:var(--red);box-shadow:0 4px 20px rgba(220,38,38,.2)}
#toast.info{border-color:var(--blue);color:var(--blue)}

/* Sync indicator */
#sync-indicator{position:fixed;top:24px;right:16px;z-index:998;display:flex;align-items:center;gap:6px;background:rgba(255,255,255,.9);backdrop-filter:blur(12px);padding:6px 12px;border-radius:20px;font-size:11px;font-weight:800;border:1px solid var(--border);box-shadow:var(--sh);transition:all .3s;opacity:0;pointer-events:none}
#sync-indicator.show{opacity:1;pointer-events:auto}
.sync-dot{width:7px;height:7px;border-radius:50%;background:var(--green);flex-shrink:0}
.sync-dot.spinning{background:var(--amber);animation:pulse 1s infinite}
.sync-dot.err{background:var(--red)}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.8)}}

/* Section label */
.sec-label{font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--text3);margin-bottom:10px;margin-top:20px;font-family:'JetBrains Mono',monospace}

/* Task items */
.task-item{display:flex;align-items:center;gap:12px;padding:13px 15px;background:rgba(255,255,255,0.7);backdrop-filter:blur(8px);border:1px solid var(--border);border-radius:14px;margin-bottom:7px;transition:all .2s;box-shadow:0 1px 8px rgba(0,0,0,.04)}
.task-item.done{opacity:.45;background:rgba(241,245,249,.6)}
.task-item.done .task-text{text-decoration:line-through;color:var(--text3)}
.task-text{font-size:15px;font-weight:600;flex:1;line-height:1.4;color:var(--text)}
.cbx{width:24px;height:24px;flex-shrink:0;border:2.5px solid var(--border);border-radius:7px;background:rgba(255,255,255,.9);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s}
.cbx.on{background:var(--green);border-color:var(--green)}
.cbx.on::after{content:'✓';color:#fff;font-size:14px;font-weight:900}
@keyframes cbPop{0%{transform:scale(1)}40%{transform:scale(1.28)}100%{transform:scale(1)}}
.cbx.pop{animation:cbPop .25s ease}

/* Ring progress */
.ring-wrap{position:relative;display:inline-flex;align-items:center;justify-content:center}
.ring-wrap svg{transform:rotate(-90deg)}
.ring-bg{fill:none;stroke:rgba(203,213,225,.5);stroke-width:7}
.ring-fg{fill:none;stroke-width:7;stroke-linecap:round;transition:stroke-dashoffset .9s cubic-bezier(.4,0,.2,1)}
.ring-label{position:absolute;text-align:center;pointer-events:none}

/* Badges */
.badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:800;letter-spacing:.3px}
.b-wait{background:var(--purple-l);color:var(--purple)}
.b-done{background:var(--green-l);color:var(--green)}

/* Stat cards */
.stat-card{background:rgba(255,255,255,0.72);backdrop-filter:blur(12px);border:1px solid var(--border);border-radius:18px;padding:14px 16px;box-shadow:var(--sh)}

/* Wait chip */
.wait-chip{display:inline-flex;align-items:center;gap:3px;padding:3px 9px;border-radius:12px;font-size:11px;font-weight:800;font-family:'JetBrains Mono',monospace}
.wait-chip.urgent{background:#fee2e2;color:#dc2626;animation:urgentPulse 2s infinite}
.wait-chip.warn{background:#fef3c7;color:#d97706}
.wait-chip.ok{background:#dcfce7;color:#16a34a}
@keyframes urgentPulse{0%,100%{box-shadow:0 0 0 0 rgba(220,38,38,.3)}50%{box-shadow:0 0 0 4px rgba(220,38,38,.0)}}

/* Annual table */
.ann-row{display:grid;grid-template-columns:44px 1fr 1fr 1fr;gap:4px;padding:7px 10px;border-radius:10px;font-size:12px;font-weight:700;align-items:center}
.ann-row.hd{background:var(--blue-l);color:var(--blue);font-size:11px;font-weight:800}
.ann-row:not(.hd):nth-child(even){background:rgba(241,245,249,.7)}
.ann-row.total-row{background:linear-gradient(135deg,var(--blue-l),var(--green-l));font-weight:900;font-size:13px;margin-top:4px}

/* Skeleton */
.skel{background:linear-gradient(90deg,rgba(203,213,225,.4) 25%,rgba(226,232,240,.6) 50%,rgba(203,213,225,.4) 75%);background-size:200% 100%;animation:skelAnim 1.5s infinite;border-radius:10px}
@keyframes skelAnim{0%{background-position:200% 0}100%{background-position:-200% 0}}
.skel-line{height:14px;margin-bottom:8px}
.skel-card{height:80px;border-radius:16px;margin-bottom:12px}

/* Profit colors */
.profit-pos{color:var(--green);font-weight:800}
.profit-neg{color:var(--red);font-weight:800}

/* Confetti */
#confetti-canvas{position:fixed;inset:0;pointer-events:none;z-index:500}

/* Filter pills */
.filter-pill{padding:6px 14px;border-radius:20px;font-size:12px;font-weight:800;cursor:pointer;border:1.5px solid var(--border);background:rgba(255,255,255,.6);backdrop-filter:blur(8px);color:var(--text2);transition:all .15s;white-space:nowrap}
.filter-pill.active{background:var(--blue);color:#fff;border-color:var(--blue);box-shadow:0 2px 10px rgba(37,99,235,.3)}

/* Growth arrows */
.arrow-up{color:var(--green);font-weight:800}
.arrow-down{color:var(--red);font-weight:800}
.arrow-flat{color:var(--text3);font-weight:700}

hr.divider{border:none;border-top:1px solid var(--border-solid);margin:14px 0}
.empty{text-align:center;padding:32px 20px;color:var(--text3);font-size:14px;font-weight:600}
.empty .ico{font-size:36px;margin-bottom:8px}

/* Gradient page headers */
.page-header-gradient{background:linear-gradient(135deg,rgba(219,234,254,.9) 0%,rgba(240,253,244,.9) 100%);backdrop-filter:var(--glass)}

/* Order number badge */
.order-num{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;color:var(--text3);background:rgba(241,245,249,.8);padding:2px 7px;border-radius:6px;border:1px solid var(--border-solid)}
</style>
</head>
<body>

<canvas id="confetti-canvas"></canvas>
<div id="toast"></div>
<div id="sync-indicator"><div class="sync-dot" id="sync-dot"></div><span id="sync-text">同步中…</span></div>

<!-- ════════════════════════════════════════
     PAGE 1 · DASHBOARD
════════════════════════════════════════ -->
<div id="page-dash" class="page active">
  <div class="glass-header page-header-gradient">
    <div class="flex items-center justify-between">
      <div>
        <div style="font-size:10px;font-weight:800;letter-spacing:2.5px;color:var(--blue);font-family:'JetBrains Mono',monospace">DASHBOARD</div>
        <h1 style="font-size:22px;font-weight:900;margin-top:1px;color:var(--text)">業績總覽</h1>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px">
        <div id="dash-date" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text3);text-align:right;line-height:1.7"></div>
        <button onclick="syncAll()" class="btn btn-ghost btn-xs" style="font-size:10px;padding:4px 10px">🔄 同步</button>
      </div>
    </div>
  </div>
  <div class="px-4 pt-3">
    <!-- Rings progress -->
    <div class="card" style="padding:20px 16px">
      <div class="flex justify-around items-center">
        <div class="text-center">
          <div class="ring-wrap">
            <svg width="88" height="88" viewBox="0 0 90 90"><circle class="ring-bg" cx="45" cy="45" r="37"/><circle class="ring-fg" id="ring-tasks" cx="45" cy="45" r="37" stroke="#2563eb" stroke-dasharray="232.5" stroke-dashoffset="232.5"/></svg>
            <div class="ring-label"><div style="font-size:21px;font-weight:900;color:var(--blue)" id="ring-tasks-pct">0%</div><div style="font-size:9px;font-weight:700;color:var(--text3)">任務</div></div>
          </div>
          <div style="font-size:11px;font-weight:700;color:var(--text2);margin-top:6px">今日進度</div>
        </div>
        <div class="text-center">
          <div class="ring-wrap">
            <svg width="88" height="88" viewBox="0 0 90 90"><circle class="ring-bg" cx="45" cy="45" r="37"/><circle class="ring-fg" id="ring-delivery" cx="45" cy="45" r="37" stroke="#16a34a" stroke-dasharray="232.5" stroke-dashoffset="232.5"/></svg>
            <div class="ring-label"><div style="font-size:21px;font-weight:900;color:var(--green)" id="ring-delivery-pct">0%</div><div style="font-size:9px;font-weight:700;color:var(--text3)">交車</div></div>
          </div>
          <div style="font-size:11px;font-weight:700;color:var(--text2);margin-top:6px">已完成率</div>
        </div>
        <div style="text-align:center">
          <div style="font-size:32px;font-weight:900;color:var(--text)" id="dash-pending-count">0</div>
          <div style="font-size:10px;font-weight:700;color:var(--amber)">⚠️ 待交車</div>
          <div style="margin-top:10px;font-size:32px;font-weight:900;color:var(--text)" id="dash-tasks-left">0</div>
          <div style="font-size:10px;font-weight:700;color:var(--blue)">今日待辦</div>
        </div>
      </div>
    </div>

    <!-- 本月業績 grid -->
    <div class="sec-label">本月業績</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">
      <div class="stat-card"><div style="font-size:10px;font-weight:700;color:var(--text3)">新車銷量</div><div style="font-size:28px;font-weight:900;color:var(--blue)" id="dash-month-sales">0</div><div style="font-size:10px" id="dash-sales-growth"></div></div>
      <div class="stat-card"><div style="font-size:10px;font-weight:700;color:var(--text3)">車輛毛利</div><div style="font-size:21px;font-weight:900;color:var(--green)" id="dash-month-profit">$0</div><div style="font-size:10px" id="dash-profit-growth"></div></div>
      <div class="stat-card"><div style="font-size:10px;font-weight:700;color:var(--text3)">本月淨利</div><div style="font-size:21px;font-weight:900" id="dash-net-profit">$0</div></div>
      <div class="stat-card"><div style="font-size:10px;font-weight:700;color:var(--text3)">任務完成</div><div style="font-size:28px;font-weight:900;color:var(--purple)" id="dash-completion-rate">0%</div><div style="font-size:10px;color:var(--text3)" id="dash-tasks-total"></div></div>
    </div>

    <!-- 待交車追蹤 -->
    <div class="sec-label">⚠️ 待交車追蹤</div>
    <div id="dash-pending-list"></div>

    <!-- 歷史對比 -->
    <div class="sec-label">歷史月份對比</div>
    <div class="card" style="padding:14px">
      <div class="flex items-center gap-2 mb-3">
        <select id="hist-month-sel" class="input" style="flex:1;font-size:13px" onchange="renderHistorical()"><option value="">— 選擇月份 —</option></select>
        <span style="font-size:11px;color:var(--text3);white-space:nowrap">vs 本月</span>
      </div>
      <div id="hist-compare" style="font-size:13px;color:var(--text2)">請選擇月份</div>
    </div>
  </div>
</div>

<!-- ════════════════════════════════════════
     PAGE 2 · DAILY TASKS
════════════════════════════════════════ -->
<div id="page-tasks" class="page">
  <div class="glass-header page-header-gradient">
    <div class="flex items-center justify-between">
      <div>
        <div style="font-size:10px;font-weight:800;letter-spacing:2.5px;color:var(--blue);font-family:'JetBrains Mono',monospace">DAILY OPS</div>
        <h1 style="font-size:22px;font-weight:900;margin-top:1px">每日任務</h1>
      </div>
      <div id="today-date" style="font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text3);text-align:right;line-height:1.7"></div>
    </div>
  </div>
  <div class="px-4 pt-2">
    <div id="moti-banner" style="display:none;background:linear-gradient(135deg,rgba(219,234,254,.9),rgba(220,252,231,.9));backdrop-filter:blur(8px);border:1px solid var(--border);border-radius:16px;padding:12px 16px;margin-bottom:12px;text-align:center;font-size:14px;font-weight:800;color:var(--blue)"></div>
    <div class="sec-label">固定任務</div>
    <div id="fixed-tasks-list"></div>
    <div class="sec-label">維修備忘錄</div>
    <div id="memo-list"></div>
    <div class="flex gap-2 mt-2">
      <input id="memo-input" class="input flex-1" placeholder="新增維修備忘錄..." style="font-size:14px">
      <button onclick="addMemo()" class="btn btn-amber" style="padding:10px 14px">+ 新增</button>
    </div>
    <div class="sec-label">自定義任務</div>
    <div id="custom-tasks-list"></div>
    <div class="flex gap-2 mt-2">
      <input id="custom-task-input" class="input flex-1" placeholder="新增任務..." style="font-size:14px">
      <button onclick="addCustomTask()" class="btn btn-blue" style="padding:10px 14px">+ 新增</button>
    </div>
    <hr class="divider">
    <button onclick="clearDoneTasks()" class="btn btn-ghost" style="width:100%">🗑️ 清除已完成任務</button>
  </div>
</div>

<!-- ════════════════════════════════════════
     PAGE 3 · EV ORDERS
════════════════════════════════════════ -->
<div id="page-orders" class="page">
  <div class="glass-header page-header-gradient">
    <div class="flex items-center justify-between mb-2">
      <div>
        <div style="font-size:10px;font-weight:800;letter-spacing:2.5px;color:var(--green);font-family:'JetBrains Mono',monospace">EV ORDERS</div>
        <h1 style="font-size:22px;font-weight:900;margin-top:1px">電子訂單</h1>
      </div>
      <button onclick="openOrderModal()" class="btn btn-green btn-sm">＋ 新增</button>
