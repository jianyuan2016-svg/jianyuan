<script>
'use strict';
// ════════════════════════════════════════
// CONFIG
// ════════════════════════════════════════
const API_URL = 'https://script.google.com/macros/s/AKfycbzHXrXJmcUO4bwUUy3lsI6nGblk8eXgPcRTYqFW0IXFKnH0i8LLfLSJFK97tamMFEWeDg/exec';

// ════════════════════════════════════════
// LOCAL STORAGE (cache layer)
// ════════════════════════════════════════
const KEYS={tasks:'evp_tasks',customTasks:'evp_custom_tasks',memos:'evp_memos',orders:'evp_orders',models:'evp_models',finance:'evp_finance'};
const DEFAULT_MODELS=['IE125','e-Moving','VIVA','其他'];
const FIXED_TASKS=[{id:'f1',text:'✅ 檢查訂單'},{id:'f2',text:'🔧 檢查客戶零件'},{id:'f3',text:'📦 常用零件是否有訂'},{id:'f4',text:'📝 維修備忘錄'}];
const MOTIVATIONS=['🎉 太厲害了！今日任務全部完成！','🚀 效率爆表！你是最強的！','💪 全部搞定，今天可以放心了！','⚡ 完美收工！業績等著你去突破！','🏆 所有任務完成！繼續保持這個節奏！'];

function load(k){try{return JSON.parse(localStorage.getItem(k))||[];}catch{return[];}}
function loadObj(k){try{return JSON.parse(localStorage.getItem(k))||{};}catch{return {};}}
function save(k,d){localStorage.setItem(k,JSON.stringify(d));}

let currentFilter='all';
let _suppressFinSave=false;
let _confirmCallback=null;

// ════════════════════════════════════════
// UTILITIES
// ════════════════════════════════════════
function esc(s){if(!s)return'';return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function fmt(n){return Math.round(n).toLocaleString('zh-TW');}
function todayStr(){const n=new Date();return`${n.getFullYear()}-${String(n.getMonth()+1).padStart(2,'0')}-${String(n.getDate()).padStart(2,'0')}`;}

function getYM(val){
  if(!val)return'';
  if(typeof val==='number'||/^\d{10,}$/.test(String(val))){
    const d=new Date(Number(val));
    return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
  }
  const parts=String(val).split('-');
  if(parts.length>=2)return`${parts[0]}-${parts[1].padStart(2,'0')}`;
  return'';
}
function getYear(val){return getYM(val).split('-')[0];}
function ymToLabel(ym){if(!ym)return'';const[y,m]=ym.split('-');return`${y} 年 ${parseInt(m)} 月`;}
function calcOrderProfit(o){return(parseFloat(o.price)||0)-(parseFloat(o.cost)||0);}

function daysSince(dateStr){
  if(!dateStr)return null;
  const p=dateStr.split('-');if(p.length<3)return null;
  const then=new Date(parseInt(p[0]),parseInt(p[1])-1,parseInt(p[2]));
  const diff=Math.floor((new Date()-then)/(864e5));
  return diff>=0?diff:0;
}
function waitChip(days){
  if(days===null)return'';
  let cls='ok';
  if(days>=14)cls='urgent';
  else if(days>=7)cls='warn';
  return`<span class="wait-chip ${cls}">⏱ ${days}天</span>`;
}
function growthHtml(cur,prev){
  if(prev===0&&cur===0)return`<span class="arrow-flat" style="font-size:10px">— 無上月資料</span>`;
  if(prev===0)return`<span class="arrow-up" style="font-size:10px">▲ 新增</span>`;
  const diff=cur-prev,pct=Math.round(Math.abs(diff)/Math.abs(prev)*100);
  if(diff>0)return`<span class="arrow-up" style="font-size:10px">▲ +${pct}%</span>`;
  if(diff<0)return`<span class="arrow-down" style="font-size:10px">▼ -${pct}%</span>`;
  return`<span class="arrow-flat" style="font-size:10px">— 持平</span>`;
}

// ════════════════════════════════════════
// TOAST
// ════════════════════════════════════════
function toast(msg,type='ok'){
  const t=document.getElementById('toast');
  t.textContent=msg;
  t.className='';
  if(type==='err')t.classList.add('err');
  else if(type==='info')t.classList.add('info');
  t.classList.add('show');
  clearTimeout(t._timer);
  t._timer=setTimeout(()=>t.classList.remove('show'),2500);
}

