function confirmAction(msg,callbackName,opts={}){
  _confirmCallback=callbackName;
  document.getElementById('confirm-msg').textContent=msg;
  document.getElementById('confirm-title').textContent=opts.title||'確認操作';
  document.getElementById('confirm-icon').textContent=opts.icon||'⚠️';
