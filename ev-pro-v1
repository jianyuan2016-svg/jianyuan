function renderTasks(){
  const states=load(KEYS.tasks);const stateMap={};states.forEach(s=>stateMap[s.id]=s.done);
  const fl=document.getElementById('fixed-tasks-list');
  fl.innerHTML='';
  FIXED_TASKS.forEach(t=>fl.appendChild(makeTaskEl(t.id,t.text,!!stateMap[t.id],false)));
  const customs=load(KEYS.customTasks);
  const cl=document.getElementById('custom-tasks-list');cl.innerHTML='';
  if(!customs.length)cl.innerHTML='<div class="empty" style="padding:12px 0;font-size:12px">尚無自定義任務</div>';
  customs.forEach(t=>cl.appendChild(makeTaskEl(t.id,t.text,!!stateMap[t.id],true)));
  renderMemos();updateDateDisplay();checkAllDone(stateMap,customs);
}

function checkAllDone(stateMap,customs){
  const allIds=[...FIXED_TASKS.map(t=>t.id),...customs.map(t=>t.id)];
  if(!allIds.length)return;
  const allDone=allIds.every(id=>stateMap[id]);
  const banner=document.getElementById('moti-banner');
  if(allDone){banner.style.display='block';banner.textContent=MOTIVATIONS[Math.floor(Math.random()*MOTIVATIONS.length)];fireConfetti();}
  else banner.style.display='none';
}

function makeTaskEl(id,text,done,canDelete){
  const div=document.createElement('div');div.className='task-item'+(done?' done':'');
  const cb=document.createElement('div');cb.className='cbx'+(done?' on':'');
  cb.onclick=()=>toggleTask(id,cb,div);
  const sp=document.createElement('span');sp.className='task-text';sp.textContent=text;
  div.appendChild(cb);div.appendChild(sp);
  if(canDelete){
    const d=document.createElement('button');d.textContent='✕';
    d.style.cssText='background:none;border:none;color:var(--text3);cursor:pointer;font-size:16px;padding:4px 6px;font-weight:700';
    d.onclick=()=>confirmAction('確定要刪除這個任務？此操作無法復原','_deleteTaskById_'+id,{icon:'🗑️',okText:'確定刪除'});
    // Register callback dynamically
    window['_deleteTaskById_'+id]=()=>deleteCustomTask(id);
    div.appendChild(d);
  }
  return div;
}

function toggleTask(id,cbEl,rowEl){
  const states=load(KEYS.tasks);const ex=states.find(s=>s.id===id);let newDone;
  if(ex){ex.done=!ex.done;newDone=ex.done;}else{states.push({id,done:true});newDone=true;}
  save(KEYS.tasks,states);
  cbEl.classList.toggle('on',newDone);cbEl.classList.toggle('pop');
  setTimeout(()=>cbEl.classList.remove('pop'),300);
  rowEl.classList.toggle('done',newDone);
  const sm={};load(KEYS.tasks).forEach(s=>sm[s.id]=s.done);
  checkAllDone(sm,load(KEYS.customTasks));
}

