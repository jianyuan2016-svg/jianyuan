function updateDateDisplay(){
  const now=new Date();const days=['日','一','二','三','四','五','六'];
  const str=`${now.getFullYear()}/${String(now.getMonth()+1).padStart(2,'0')}/${String(now.getDate()).padStart(2,'0')}<br>星期${days[now.getDay()]}`;
  const el=document.getElementById('today-date');if(el)el.innerHTML=str;
}

