          ${note}
        </div>
        <div style="display:flex;flex-direction:column;gap:5px;flex-shrink:0">
          <button onclick='openOrderModal(${JSON.stringify(o).replace(/'/g,"&#39;")})' style="background:rgba(255,255,255,.8);border:1.5px solid var(--border);color:var(--text2);padding:5px 10px;border-radius:8px;cursor:pointer;font-size:11px;font-weight:800">✏️</button>
          <button onclick="confirmDeleteOrder('${o.id}')" style="background:var(--red-l);border:1.5px solid #fca5a5;color:var(--red);padding:5px 10px;border-radius:8px;cursor:pointer;font-size:11px;font-weight:800">🗑️</button>
        </div>
      </div>
      <div style="margin-top:6px;font-size:10px;color:var(--text3);font-family:'JetBrains Mono',monospace">${o.orderDate||''}</div>`;
    list.appendChild(card);
  });
}

function confirmDeleteOrder(id){
  const orders=load(KEYS.orders);
  const o=orders.find(x=>x.id===id);
  const name=o?o.name:'此訂單';
  window._pendingDeleteOrderId=id;
  confirmAction(`確定要刪除「${name}」的訂單嗎？\n此操作將同時從 Google Sheets 移除，無法復原。`,'_execDeleteOrder',{icon:'🗑️',okText:'確定刪除'});
}
window._execDeleteOrder=async function(){
  const id=window._pendingDeleteOrderId;if(!id)return;
  const orders=load(KEYS.orders);
  const o=orders.find(x=>x.id===id);
  save(KEYS.orders,orders.filter(x=>x.id!==id));
  renderOrders();renderDashboard();
  toast('🗑️ 訂單已刪除');
  if(o)await pushOrderToSheets(o,true);
};

function openOrderModal(order=null){
  document.getElementById('modal-title').textContent=order?'編輯訂單':'新增訂單';
  document.getElementById('edit-order-id').value=order?order.id:'';
  document.getElementById('f-ordernum').value=order?(order.orderNum||''):'';
  document.getElementById('f-date').value=order?order.orderDate:todayStr();
  document.getElementById('f-name').value=order?order.name:'';
  document.getElementById('f-phone').value=order?order.phone:'';
  document.getElementById('f-battery').value=order?order.battery:'';
  document.getElementById('f-status').value=order?order.status:'待交車';
  document.getElementById('f-price').value=order&&order.price?order.price:'';
  document.getElementById('f-cost').value=order&&order.cost?order.cost:'';
  document.getElementById('f-note').value=order?order.note:'';
  populateModelSelect(order?order.model:'');
  calcProfit();
  document.getElementById('order-modal').style.display='flex';
  setTimeout(()=>document.getElementById('f-name').focus(),300);
}

function closeOrderModal(){document.getElementById('order-modal').style.display='none';}
function handleOverlayClick(e){if(e.target===document.getElementById('order-modal'))closeOrderModal();}

function calcProfit(){
  const price=parseFloat(document.getElementById('f-price').value)||0;
  const cost=parseFloat(document.getElementById('f-cost').value)||0;
  const p=price-cost;
  const el=document.getElementById('f-profit-preview');
  el.textContent=(p>=0?'+':'')+'$'+fmt(p);
  el.style.color=p>0?'var(--green)':p<0?'var(--red)':'var(--text2)';
}

async function saveOrder(){
  const name=document.getElementById('f-name').value.trim();
  if(!name){toast('⚠️ 請填寫客戶姓名','err');return;}
  const editId=document.getElementById('edit-order-id').value;
  const orders=load(KEYS.orders);
  const orderDate=document.getElementById('f-date').value||todayStr();
  const data={
    id:editId||'o_'+Date.now(),
    orderNum:document.getElementById('f-ordernum').value.trim(),
    orderDate,
    name,
    phone:document.getElementById('f-phone').value.trim(),
    model:document.getElementById('f-model').value,
    battery:document.getElementById('f-battery').value.trim(),
    status:document.getElementById('f-status').value,
    price:parseFloat(document.getElementById('f-price').value)||0,
    cost:parseFloat(document.getElementById('f-cost').value)||0,
    note:document.getElementById('f-note').value.trim(),
    createdAt:editId?(orders.find(o=>o.id===editId)?.createdAt||Date.now()):Date.now(),
    updatedAt:Date.now(),
  };
  if(editId){const i=orders.findIndex(o=>o.id===editId);if(i!==-1)orders[i]=data;else orders.push(data);}
  else orders.push(data);
  save(KEYS.orders,orders);
  closeOrderModal();renderOrders();renderDashboard();
  toast(editId?'✓ 訂單已更新':'✓ 訂單已新增');
  await pushOrderToSheets(data,false);
}

document.getElementById('search-input').addEventListener('keydown',e=>{if(e.key==='Enter')e.target.blur();});

// ════════════════════════════════════════
// FINANCE
// ════════════════════════════════════════
function getAllYears(){
  const orders=load(KEYS.orders);const now=new Date();
  const ys=new Set([String(now.getFullYear())]);
  orders.forEach(o=>{const y=getYear(o.orderDate||o.createdAt);if(y)ys.add(y);});
  return[...ys].sort().reverse();
}

function getMonthsForYear(year){
  const orders=load(KEYS.orders);const now=new Date();
  const ms=new Set();
  orders.filter(o=>{const ym=getYM(o.orderDate||o.createdAt);return ym&&ym.startsWith(year+'-');}).forEach(o=>{ms.add(getYM(o.orderDate||o.createdAt));});
  if(String(now.getFullYear())===String(year))ms.add(`${year}-${String(now.getMonth()+1).padStart(2,'0')}`);
  if(ms.size===0)for(let m=1;m<=12;m++)ms.add(`${year}-${String(m).padStart(2,'0')}`);
  return[...ms].sort().reverse();
}

function populateFinSelectors(){
  const now=new Date();
  const curYear=String(now.getFullYear());
  const curYm=`${curYear}-${String(now.getMonth()+1).padStart(2,'0')}`;
  const yearSel=document.getElementById('fin-year-sel');
  const monthSel=document.getElementById('fin-month-sel');
  const prevYear=yearSel.value;const prevMonth=monthSel.value;
  const years=getAllYears();
  yearSel.innerHTML='';
  years.forEach(y=>{const o=document.createElement('option');o.value=y;o.textContent=y+' 年';if(y===(prevYear||curYear))o.selected=true;yearSel.appendChild(o);});
  if(!yearSel.value&&years.length)yearSel.value=years[0];
  populateFinMonthsForYear(yearSel.value,prevMonth||curYm);
}

function populateFinMonthsForYear(year,preferYm){
  const monthSel=document.getElementById('fin-month-sel');
  const months=getMonthsForYear(year);
  monthSel.innerHTML='';
  months.forEach(ym=>{const o=document.createElement('option');o.value=ym;o.textContent=ymToLabel(ym);if(ym===preferYm)o.selected=true;monthSel.appendChild(o);});
  if(!monthSel.value&&months.length)monthSel.value=months[0];
}

function onFinYearChange(){
  const year=document.getElementById('fin-year-sel').value;
  populateFinMonthsForYear(year,'');renderFinance();
}

function renderFinance(){
  const ym=document.getElementById('fin-month-sel')?.value;if(!ym)return;
  const orders=load(KEYS.orders).filter(o=>getYM(o.orderDate||o.createdAt)===ym);
  const finData=loadObj(KEYS.finance);
  const fd=finData[ym]||{};
  _suppressFinSave=true;
  document.getElementById('fin-repair-income').value=fd.repair||'';
  document.getElementById('fin-expense').value=fd.expense||'';
  document.getElementById('fin-other-income').value=fd.other||'';
  _suppressFinSave=false;
  const gross=orders.reduce((s,o)=>s+calcOrderProfit(o),0);
  const revenue=orders.reduce((s,o)=>s+(o.price||0),0);
  const repair=parseFloat(fd.repair||0),expense=parseFloat(fd.expense||0),other=parseFloat(fd.other||0);
  const net=gross+repair+other-expense;
  document.getElementById('fin-count').textContent=orders.length;
  document.getElementById('fin-revenue').textContent='$'+fmt(revenue);
  const gEl=document.getElementById('fin-gross');gEl.textContent='$'+fmt(gross);gEl.className=gross>=0?'profit-pos':'profit-neg';
  const nEl=document.getElementById('fin-net');nEl.textContent=(net>=0?'+':'')+'$'+fmt(net);nEl.style.color=net>0?'var(--green)':net<0?'var(--red)':'var(--text2)';
  document.getElementById('fin-d-gross').textContent='$'+fmt(gross);document.getElementById('fin-d-gross').className=gross>=0?'profit-pos':'profit-neg';
  document.getElementById('fin-d-repair').textContent='$'+fmt(repair);
  document.getElementById('fin-d-other').textContent='$'+fmt(other);
  document.getElementById('fin-d-exp').textContent='$'+fmt(expense);
  renderAnnualTable();
  const ol=document.getElementById('fin-order-list');
  if(!orders.length){ol.innerHTML='<div class="empty">本月尚無訂單</div>';return;}
  ol.innerHTML='';
  orders.sort((a,b)=>a.orderDate<b.orderDate?1:-1).forEach(o=>{
    const p=calcOrderProfit(o);const d=document.createElement('div');d.className='card-flat';
    d.style.display='flex';d.style.justifyContent='space-between';d.style.alignItems='center';
    d.innerHTML=`<div>
      ${o.orderNum?`<span class="order-num" style="margin-right:4px">${esc(o.orderNum)}</span>`:''}
      <span style="font-weight:800;font-size:14px">${esc(o.name)}</span>
      <div style="font-size:11px;color:var(--text3)">${o.model||'—'} · ${o.orderDate||''}</div>
    </div>
    <div style="text-align:right"><div style="font-size:11px;color:var(--text3)">售$${fmt(o.price||0)} / 成$${fmt(o.cost||0)}</div><div style="font-weight:900;font-size:16px;${p>=0?'color:var(--green)':'color:var(--red)'}">${p>=0?'+':''}$${fmt(p)}</div></div>`;
    ol.appendChild(d);
  });
}

async function saveFinManual(){
  if(_suppressFinSave)return;
  const ym=document.getElementById('fin-month-sel')?.value;if(!ym)return;
  const finData=loadObj(KEYS.finance);
  finData[ym]={
    repair:document.getElementById('fin-repair-income').value||'0',
    expense:document.getElementById('fin-expense').value||'0',
    other:document.getElementById('fin-other-income').value||'0',
  };
  save(KEYS.finance,finData);
  // Recalculate net
  const orders=load(KEYS.orders).filter(o=>getYM(o.orderDate||o.createdAt)===ym);
  const gross=orders.reduce((s,o)=>s+calcOrderProfit(o),0);
  const repair=parseFloat(finData[ym].repair),expense=parseFloat(finData[ym].expense),other=parseFloat(finData[ym].other);
  const net=gross+repair+other-expense;
  const nEl=document.getElementById('fin-net');nEl.textContent=(net>=0?'+':'')+'$'+fmt(net);nEl.style.color=net>0?'var(--green)':net<0?'var(--red)':'var(--text2)';
  document.getElementById('fin-d-repair').textContent='$'+fmt(repair);
  document.getElementById('fin-d-other').textContent='$'+fmt(other);
  document.getElementById('fin-d-exp').textContent='$'+fmt(expense);
  renderAnnualTable();
  await pushFinanceToSheets(ym,finData[ym]);
}

function renderAnnualTable(){
  const year=document.getElementById('fin-year-sel')?.value;if(!year)return;
  const orders=load(KEYS.orders);const finData=loadObj(KEYS.finance);
  const tbl=document.getElementById('fin-annual-table');tbl.innerHTML='';
  const hdr=document.createElement('div');hdr.className='ann-row hd';
  hdr.innerHTML='<div>月</div><div>毛利</div><div>淨利</div><div>台數</div>';tbl.appendChild(hdr);
  let tg=0,tn=0,ts=0;
  for(let m=1;m<=12;m++){
    const ym=`${year}-${String(m).padStart(2,'0')}`;
    const mo=orders.filter(o=>getYM(o.orderDate||o.createdAt)===ym);
    const fd=finData[ym]||{};
    const gross=mo.reduce((s,o)=>s+calcOrderProfit(o),0);
    const repair=parseFloat(fd.repair||0),expense=parseFloat(fd.expense||0),other=parseFloat(fd.other||0);
    const net=gross+repair+other-expense;
    tg+=gross;tn+=net;ts+=mo.length;
    const row=document.createElement('div');row.className='ann-row';
    row.style.opacity=(mo.length>0||repair||expense||other)?'1':'0.35';
    row.innerHTML=`<div style="color:var(--text2)">${m}月</div>
      <div style="${gross>0?'color:var(--green)':gross<0?'color:var(--red)':'color:var(--text3)'}">$${fmt(gross)}</div>
      <div style="${net>0?'color:var(--green)':net<0?'color:var(--red)':'color:var(--text3)'}">$${fmt(net)}</div>
      <div style="color:var(--blue)">${mo.length||'—'}</div>`;
    tbl.appendChild(row);
  }
  const tot=document.createElement('div');tot.className='ann-row total-row';
  tot.innerHTML=`<div style="color:var(--blue-d)">合計</div>
    <div style="${tg>=0?'color:var(--green)':'color:var(--red)'}">$${fmt(tg)}</div>
    <div style="${tn>=0?'color:var(--green)':'color:var(--red)'}">$${fmt(tn)}</div>
    <div style="color:var(--blue)">${ts}</div>`;
  tbl.appendChild(tot);
}

// ════════════════════════════════════════
// VEHICLE MODELS
// ════════════════════════════════════════
function getModels(){const m=load(KEYS.models);return m.length?m:[...DEFAULT_MODELS];}

function renderModelList(){
  const models=getModels();const ml=document.getElementById('model-list-ui');ml.innerHTML='';
  models.forEach((m,i)=>{
    const d=document.createElement('div');d.className='card-flat';
    d.style.cssText='display:flex;align-items:center;justify-content:space-between;';
    d.innerHTML=`<span style="font-weight:700;font-size:15px">🛵 ${esc(m)}</span>
    <button onclick="confirmAction('確定刪除「${esc(m)}」車型？','_deleteModel${i}',{icon:'🛵',okText:'確定刪除'})" style="background:var(--red-l);border:1.5px solid #fca5a5;color:var(--red);padding:5px 11px;border-radius:8px;cursor:pointer;font-size:12px;font-weight:800">刪除</button>`;
    window[`_deleteModel${i}`]=()=>{const models=getModels();models.splice(i,1);save(KEYS.models,models);renderModelList();toast('🗑️ 車型已刪除');};
    ml.appendChild(d);
  });
}

function addVehicleModel(){
  const inp=document.getElementById('new-model-input');const name=inp.value.trim();if(!name)return;
  const models=getModels();if(models.includes(name)){toast('⚠️ 車型已存在','err');return;}
  models.push(name);save(KEYS.models,models);inp.value='';renderModelList();toast('✓ 車型已新增');
}

function populateModelSelect(current=''){
  const sel=document.getElementById('f-model');const models=getModels();
  sel.innerHTML='<option value="">請選擇</option>';
  models.forEach(m=>{const o=document.createElement('option');o.value=m;o.textContent=m;if(m===current)o.selected=true;sel.appendChild(o);});
}

document.getElementById('new-model-input').addEventListener('keydown',e=>{if(e.key==='Enter')addVehicleModel();});

// ════════════════════════════════════════
// BACKUP / RESTORE
// ════════════════════════════════════════
function exportData(){
  const data={exportedAt:new Date().toISOString(),tasks:load(KEYS.tasks),customTasks:load(KEYS.customTasks),memos:load(KEYS.memos),orders:load(KEYS.orders),models:load(KEYS.models),finance:loadObj(KEYS.finance)};
  const json=JSON.stringify(data,null,2);
  document.getElementById('export-output').value=json;
  try{navigator.clipboard.writeText(json);toast('✓ JSON 已複製到剪貼簿');}catch{toast('✓ 請手動複製 JSON');}
}

function importData(){
  const raw=document.getElementById('import-input').value.trim();
  if(!raw){toast('⚠️ 請貼上 JSON','err');return;}
  try{
    const d=JSON.parse(raw);
    if(d.tasks)save(KEYS.tasks,d.tasks);if(d.customTasks)save(KEYS.customTasks,d.customTasks);
    if(d.memos)save(KEYS.memos,d.memos);if(d.orders)save(KEYS.orders,d.orders);
    if(d.models)save(KEYS.models,d.models);if(d.finance)save(KEYS.finance,d.finance);
    document.getElementById('import-input').value='';
    renderTasks();renderOrders();renderModelList();renderStorageStats();
    toast('✓ 資料已成功匯入');
  }catch{toast('❌ JSON 格式錯誤','err');}
}

function clearAllData(){
  Object.values(KEYS).forEach(k=>localStorage.removeItem(k));
  renderTasks();renderOrders();renderModelList();renderStorageStats();
  toast('🗑️ 本地資料已清除');
}

function renderStorageStats(){
  const orders=load(KEYS.orders);const customs=load(KEYS.customTasks);const memos=load(KEYS.memos);
  document.getElementById('storage-stats').innerHTML=
    `<div>📦 訂單：<strong style="color:var(--blue)">${orders.length} 筆</strong></div>
     <div>✅ 自定義任務：<strong style="color:var(--green)">${customs.length} 項</strong></div>
     <div>📝 備忘錄：<strong style="color:var(--amber)">${memos.length} 則</strong></div>
     <div>🛵 車型：<strong>${getModels().length} 種</strong></div>
     <div>🕐 <span style="color:var(--text3)">${new Date().toLocaleString('zh-TW')}</span></div>`;
}

