function renderDashboard(){
  const now=new Date();
  const thisYm=`${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`;
  const lastD=new Date(now.getFullYear(),now.getMonth()-1,1);
  const lastYm=`${lastD.getFullYear()}-${String(lastD.getMonth()+1).padStart(2,'0')}`;
  const days=['日','一','二','三','四','五','六'];
  document.getElementById('dash-date').innerHTML=`${now.getFullYear()}/${String(now.getMonth()+1).padStart(2,'0')}/${String(now.getDate()).padStart(2,'0')}<br>星期${days[now.getDay()]}`;

  // Tasks
  const states=load(KEYS.tasks);const stateMap={};states.forEach(s=>stateMap[s.id]=s.done);
  const customs=load(KEYS.customTasks);
  const allIds=[...FIXED_TASKS.map(t=>t.id),...customs.map(t=>t.id)];
  const doneCount=allIds.filter(id=>stateMap[id]).length;
  const totalTasks=allIds.length;
  const taskPct=totalTasks>0?doneCount/totalTasks:0;
  setRing('ring-tasks',taskPct);
  document.getElementById('ring-tasks-pct').textContent=Math.round(taskPct*100)+'%';
  document.getElementById('dash-tasks-left').textContent=Math.max(0,totalTasks-doneCount);
  document.getElementById('dash-completion-rate').textContent=Math.round(taskPct*100)+'%';
  document.getElementById('dash-tasks-total').textContent=`${doneCount}/${totalTasks} 完成`;

  // Orders
  const orders=load(KEYS.orders);
  const thisOrders=orders.filter(o=>getYM(o.orderDate||o.createdAt)===thisYm);
  const lastOrders=orders.filter(o=>getYM(o.orderDate||o.createdAt)===lastYm);
  const pendingOrders=orders.filter(o=>o.status==='待交車');
  const doneOrders=orders.filter(o=>o.status==='已完結');
  const delivTotal=doneOrders.length+pendingOrders.length;
  const delivPct=delivTotal>0?doneOrders.length/delivTotal:0;
  setRing('ring-delivery',delivPct);
  document.getElementById('ring-delivery-pct').textContent=Math.round(delivPct*100)+'%';
  document.getElementById('dash-pending-count').textContent=pendingOrders.length;

  const thisSales=thisOrders.length,lastSales=lastOrders.length;
  const thisProfit=thisOrders.reduce((s,o)=>s+calcOrderProfit(o),0);
  const lastProfit=lastOrders.reduce((s,o)=>s+calcOrderProfit(o),0);
  document.getElementById('dash-month-sales').textContent=thisSales;
  document.getElementById('dash-month-profit').textContent='$'+fmt(thisProfit);
  document.getElementById('dash-sales-growth').innerHTML=growthHtml(thisSales,lastSales);
  document.getElementById('dash-profit-growth').innerHTML=growthHtml(thisProfit,lastProfit);

  const finData=loadObj(KEYS.finance);
  const fd=finData[thisYm]||{};
  const repair=parseFloat(fd.repair||0),expense=parseFloat(fd.expense||0),other=parseFloat(fd.other||0);
  const net=thisProfit+repair+other-expense;
  const netEl=document.getElementById('dash-net-profit');
  netEl.textContent='$'+fmt(net);
  netEl.style.color=net>0?'var(--green)':net<0?'var(--red)':'var(--text2)';

  // Pending list
  const pl=document.getElementById('dash-pending-list');
  if(!pendingOrders.length){
    pl.innerHTML='<div class="empty" style="padding:16px 0"><div class="ico">🎉</div><p>目前沒有待交車訂單！</p></div>';
  }else{
    pl.innerHTML='';
    pendingOrders.sort((a,b)=>(daysSince(b.orderDate)||0)-(daysSince(a.orderDate)||0)).forEach(o=>{
      const days=daysSince(o.orderDate);
      const isUrgent=days!==null&&days>=7;
      const d=document.createElement('div');
      d.className='card-flat';
      if(isUrgent)d.style.borderColor='rgba(220,38,38,.4)';
      d.style.display='flex';d.style.justifyContent='space-between';d.style.alignItems='center';
      d.innerHTML=`<div style="flex:1;min-width:0">
        ${o.orderNum?`<span class="order-num">${esc(o.orderNum)}</span> `:''}
        <span style="font-weight:800;font-size:15px${isUrgent?';color:var(--red)':''}">${esc(o.name)}</span>
        <div style="font-size:11px;color:var(--text3);margin-top:2px">${o.model||'—'}${o.orderDate?' · '+o.orderDate:''}</div>
        ${o.phone?`<a href="tel:${o.phone}" style="font-size:12px;color:var(--blue);font-weight:700;display:block;margin-top:2px">📞 ${esc(o.phone)}</a>`:''}
      </div>
      <div style="text-align:right;flex-shrink:0;margin-left:8px">${waitChip(days)}</div>`;
      pl.appendChild(d);
    });
  }
  populateHistSel();
}

